# ==============================================================================
# SECURITY NOTICE
# ==============================================================================
# This file MUST be copied to `.env` for local development. NEVER commit a real
# `.env` file: it contains secrets. The repository's `.gitignore` excludes all
# `.env*` files except `.env.example`.
#
# spring-dotenv (https://github.com/paulschwarz/spring-dotenv) auto-loads
# `.env` from the working directory at application startup. Production
# deployments MUST inject secrets via the orchestrator (k8s Secrets, AWS
# Secrets Manager, Vault, etc.) and SHOULD NOT ship a `.env` file.
#
# Minimum JWT_SECRET length: 32 bytes (256 bits) — the application refuses to
# start if JWT_SECRET is missing or shorter than this.
# ==============================================================================
# PostgreSQL Connection (local dev runs on port 5433 to avoid conflicts)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/pwb_db
SPRING_DATASOURCE_USERNAME=pwb_user
SPRING_DATASOURCE_PASSWORD=pwb_password

# MongoDB Connection
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/pwb_db

# ==============================================================================
# Cache & Memory Grid (Redis)
# ==============================================================================
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=pwb_redis_secret_pass
REDIS_PASSWORD=pwb_redis_secret_pass

# ==============================================================================
# Messaging & Event Broker (Kafka)
# ==============================================================================
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# KAFKA_SECURITY_PROTOCOL: PLAINTEXT (default), SSL, SASL_PLAINTEXT, SASL_SSL
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
# KAFKA_SASL_MECHANISM: PLAIN, SCRAM-SHA-256, SCRAM-SHA-512 (only when security
# protocol is SASL_*)
KAFKA_SASL_MECHANISM=
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
# For advanced SASL setups, the raw JAAS config can be set as well
KAFKA_SASL_JAAS_CONFIG=

# ==============================================================================
# Security & Token Management (JWT)
# ==============================================================================
# Ensure this secret key is HS256 compatible and has at least 256 bits
JWT_SECRET=db7f8ea61b9a2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d8e9f0a1b2c3d4e5f6a7b8c9d0e1f2a3b4c5d6e7f8a9b0c1d2e3f4a5b6c7d

# ==============================================================================
# Notification Server (Gmail SMTP Connection)
# ==============================================================================
MAIL_USERNAME=your_gmail_account@gmail.com
MAIL_PASSWORD=your_app_specific_password

# ==============================================================================
# Object Storage Configuration (AWS S3 & Local MinIO)
# ==============================================================================
# STORAGE_ENDPOINT: Override with local MinIO console endpoint (port 9000)
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET_NAME=pwb-mini-dev-bucket
STORAGE_ACCESS_KEY=minio_admin
STORAGE_SECRET_KEY=minio_password
STORAGE_REGION=us-east-1
# Set this value on Production if CloudFront CDN is enabled (e.g., https://media.pwbmini.com)
STORAGE_PUBLIC_URL_PREFIX=
S3_BUCKET_NAME=pwb-mini-dev-bucket

# ==============================================================================
# Identity & Access Management (Google OAuth & GeoIP)
# ==============================================================================
# Google Cloud Console OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# GeoIP City Database absolute path (Optional, defaults to classpath:geoip/GeoLite2-City.mmdb)
GEOIP_DB_PATH=

# ==============================================================================
# Audio Streaming Module (Sprint 2 / 3)
# ==============================================================================
# AES-128 master key for HLS segment encryption (must be 32 hex chars = 16 bytes raw)
AUDIO_AES_MASTER_KEY=
# AES-256 master key for outbox payload encryption (32 bytes raw)
AUDIO_OUTBOX_ENCRYPTION_KEY=
# Google Cloud Text-to-Speech credentials JSON path (empty = ADC)
GCP_TTS_CREDENTIALS_PATH=
GCP_PROJECT_ID=
# Public base URL for shared demo links (used by distribution links / emails)
APP_PUBLIC_BASE_URL=http://localhost:3000
# FFmpeg / ffprobe binary paths (override if not on PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
AUDIO_TEMP_DIR=/tmp/pwb-audio
# HS256 secret for the HLS stream secure cookie (min 32 bytes)
AUDIO_STREAM_COOKIE_SECRET=
# Salt for SHA-256 IP hashing (GDPR pseudonymization; rotate every 90 days)
AUDIO_IP_HASH_SALT=
