# 3. Cấu hình IDE / OS / Công cụ
# ==========================================
.idea/
.vscode/
.vs/
.claude/
*.suo
.DS_Store
Thumbs.db
*.log
*.tmp

# ==========================================
# 4. Backend (Java / Spring Boot / Maven)
# ==========================================
**/target/
**/bin/
**/build/
**/cp.txt
**/cp-test.txt

# ==========================================
# 5. Frontend (Node.js / Next.js / pnpm)
# ==========================================
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/build/
frontend/dist/
frontend/npm-debug.log*
frontend/yarn-debug.log*
frontend/yarn-error.log*
frontend/pnpm-debug.log*
frontend/.turbo/
frontend/coverage/

# GCP service-account keys - never commit; supply via GCP_TTS_CREDENTIALS_PATH.
# Nơi chứa credential đúng là `secrets/` (đã ignore ở trên) — bất cứ file json nào rơi vào
# `src/main/resources/tts/` đều bị Maven đóng thẳng vào jar, nên pattern dưới đây cố tình bao
# mọi module chứ không chỉ `audio`: key đã từng nằm ở `bootstrap/` một lần (commit e279770),
# và `.env` vẫn còn trỏ vào đó rất lâu sau khi thư mục ấy biến mất.
**/src/main/resources/tts/*.json
