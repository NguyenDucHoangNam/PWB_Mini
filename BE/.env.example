
# ==============================================================================
# Database Configuration
# ==============================================================================
# PostgreSQL Connection (local dev runs on port 5433 to avoid conflicts)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5433/pwb_db
SPRING_DATASOURCE_USERNAME=pwb_user
SPRING_DATASOURCE_PASSWORD=pwb_password

# MongoDB Connection
SPRING_DATA_MONGODB_URI=mongodb://localhost:27017/pwb_db

# ==============================================================================
# Cache & Memory Grid (Redis)
# ==============================================================================
SPRING_DATA_REDIS_HOST=localhost
SPRING_DATA_REDIS_PORT=6379
SPRING_DATA_REDIS_PASSWORD=your_redis_password
# REDIS_PASSWORD is read by docker-compose.yml (NOT by Spring) to provision
# the local Redis container with the same secret used by the app.
REDIS_PASSWORD=your_redis_password

# ==============================================================================
# Messaging & Event Broker (Kafka)
# ==============================================================================
SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ==============================================================================
# Security & Token Management (JWT)
# ==============================================================================
# HS256 secret keys — generate with: openssl rand -hex 32
JWT_SECRET=<generate-with-openssl-rand-hex-32>
JWT_REFRESH_SECRET=<generate-with-openssl-rand-hex-32>

# ==============================================================================
# Notification Server (Gmail SMTP — credentials only)
# ==============================================================================
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password

# ==============================================================================
# Object Storage (AWS S3 / Local MinIO — credentials only)
# ==============================================================================
STORAGE_ENDPOINT=https://s3.ap-southeast-1.amazonaws.com
STORAGE_ACCESS_KEY=your_aws_access_key
STORAGE_SECRET_KEY=your_aws_secret_key
# Set on Production if CloudFront CDN is enabled (e.g. https://cdn.pwbmini.com)
STORAGE_PUBLIC_URL_PREFIX=https://your-cdn-domain.cloudfront.net

# ==============================================================================
# Identity & Access Management (Google OAuth & GCP)
# ==============================================================================
# Google Cloud Console OAuth Client ID
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com

# Frontend URL for password reset links
FRONTEND_URL=http://localhost:3000
# Google Cloud Text-to-Speech credentials JSON path (empty = ADC)
GCP_TTS_CREDENTIALS_PATH=
GCP_PROJECT_ID=your_gcp_project_id

# ==============================================================================
# Encryption Keys
# ==============================================================================
# AES-128 master key for HLS segment encryption (must be 32 hex chars = 16 bytes raw)
# Generate with: openssl rand -hex 16
AUDIO_AES_MASTER_KEY=<generate-with-openssl-rand-hex-16>
# IAM Outbox PII encryption (AES-256-GCM, at-rest only; Kafka payload stays plaintext)
# Generate with: openssl rand -base64 32
IAM_OUTBOX_ENCRYPTION_KEY=<generate-with-openssl-rand-base64-32>

# ==============================================================================
# Audio Stream Security
# ==============================================================================
# HS256 secret for the HLS stream secure cookie (min 32 bytes)
# Generate with: openssl rand -base64 32
AUDIO_STREAM_COOKIE_SECRET=<generate-with-openssl-rand-base64-32>
# Salt for SHA-256 IP hashing (GDPR pseudonymization; rotate every 90 days)
# Generate with: openssl rand -base64 32
AUDIO_IP_HASH_SALT=<generate-with-openssl-rand-base64-32>

# ==============================================================================
# Captcha (Cloudflare Turnstile)
# ==============================================================================
APP_SECURITY_CAPTCHA_TURNSTILE_SECRET_KEY=your_turnstile_secret_key
APP_SECURITY_CAPTCHA_TURNSTILE_SITE_KEY=your_turnstile_site_key

# ==============================================================================
# Spring Profile
# ==============================================================================
SPRING_PROFILES_ACTIVE=local
