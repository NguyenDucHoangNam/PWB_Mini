spring:
  datasource:
    url: jdbc:postgresql://localhost:5433/pwb_db
    username: pwb_user
    password: ${POSTGRES_PASSWORD}
  data:
    mongodb:
      uri: mongodb://localhost:27017/pwb_db
    redis:
      host: localhost
      port: 6379
      password: ${REDIS_PASSWORD:}
  kafka:
    bootstrap-servers: localhost:9092

server:
  port: 8080

logging:
  level:
    com.pwb.backend: DEBUG

app:
  cors:
    allowed-origins:
      - http://localhost:3000
      - http://localhost:5173
  storage:
    endpoint: http://localhost:9000
    access-key: ${MINIO_ROOT_USER}
    secret-key: ${MINIO_ROOT_PASSWORD}
    bucket-name: pwb-media
    region: us-east-1
    public-url-prefix: http://localhost:9000/pwb-media
  audio:
    worker:
      ffmpeg-path: ${FFMPEG_PATH:C:\ffmpeg\bin\ffmpeg.exe}
      ffprobe-path: ${FFPROBE_PATH:C:\ffmpeg\bin\ffprobe.exe}
      temp-dir: ${FFMPEG_TEMP_DIR:D:/tmp/pwb-audio}
      host-temp-dir: ${FFMPEG_HOST_TEMP_DIR:D:/tmp/pwb-audio}
  iam:
    seeder:
      enabled: true
      users:
        - email: pwb.user01@gmail.com
          password: "@NamHoang511"
          fullName: User One
          role: USER
        - email: pwb.user02@gmail.com
          password: "@NamHoang511"
          fullName: User Two
          role: USER
        - email: pwb.pro01@gmail.com
          password: "@NamHoang511"
          fullName: Pro One
          role: PRO
        - email: pwb.pro02@gmail.com
          password: "@NamHoang511"
          fullName: Pro Two
          role: PRO
        - email: pwb.admin01@gmail.com
          password: "@NamHoang511"
          fullName: Admin One
          role: ADMIN
        - email: pwb.admin02@gmail.com
          password: "@NamHoang511"
          fullName: Admin Two
          role: ADMIN
