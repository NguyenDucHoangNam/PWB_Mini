# ==============================================================================
# Production environment — template
# ==============================================================================
#
# Copy to `.env.prod` on the VPS, fill every <...> placeholder, then `chmod 600 .env.prod`.
# `.env.prod` itself is gitignored; this template is not, so never put a real value here.
#
#   cp .env.prod.example .env.prod && chmod 600 .env.prod
#
# Every variable below is read by something. Variables absent from this file but present in the
# development `.env` were checked against the source and are read by nothing — see the notes at the
# bottom before copying anything across.
#
# Not listed here because docker-compose.prod.yml sets them from the values below:
#   SPRING_DATASOURCE_URL / _USERNAME / _PASSWORD, SPRING_DATA_REDIS_HOST / _PORT / _PASSWORD,
#   SPRING_KAFKA_BOOTSTRAP_SERVERS, SPRING_ELASTICSEARCH_URIS, SPRING_PROFILES_ACTIVE,
#   PWB_CORS_ALLOWED_ORIGINS, FRONTEND_URL, GCP_TTS_CREDENTIALS_PATH


# ==============================================================================
# Domains
# ==============================================================================
# Both must already resolve to this VPS before running nginx/init-letsencrypt.sh.
# Everything else derives from these: CORS origins, the password-reset link in outgoing mail, the
# API base URL baked into the frontend bundle, and the certificate names.
FRONTEND_DOMAIN=producerworkbench.online
API_DOMAIN=api.producerworkbench.online


# ==============================================================================
# PostgreSQL
# ==============================================================================
# Used by the postgres container and, through compose, by the backend's datasource.
POSTGRES_DB=pwb_db
POSTGRES_USER=pwb_user
POSTGRES_PASSWORD=<openssl rand -base64 24>


# ==============================================================================
# Redis
# ==============================================================================
REDIS_PASSWORD=<openssl rand -base64 24>


# ==============================================================================
# Application secrets
# ==============================================================================
# Generate fresh values; do not carry the development ones across.
#
#   openssl rand -base64 48
#
# Both are required with no fallback — the application refuses to start without them rather than
# booting with a weak default. APP_JWT_SECRET must decode to at least 32 bytes or jjwt rejects it
# at startup with WeakKeyException.
APP_JWT_SECRET=<openssl rand -base64 48>
APP_PASSWORD_RESET_TOKEN_SECRET=<openssl rand -base64 48>


# ==============================================================================
# Email (OTP, password reset)
# ==============================================================================
# A Gmail app password works for a demo. Registration cannot complete without working mail: the OTP
# is delivered through Kafka to this SMTP server.
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=<your@gmail.com>
SPRING_MAIL_PASSWORD=<gmail app password, 16 chars, no spaces>

# Shown as the sender. Optional — defaults to noreply@pwb.com / PWB.
MAIL_FROM_ADDRESS=noreply@producerworkbench.online
MAIL_FROM_NAME=Producer Workbench


# ==============================================================================
# AWS S3
# ==============================================================================
# Uploads and playback go directly between the browser and S3 using presigned URLs, so the bucket
# needs a CORS rule allowing https://producerworkbench.online — without it every upload and every
# play fails in the browser while the server logs nothing.
STORAGE_S3_BUCKET=<bucket name>
STORAGE_S3_REGION=ap-southeast-1
STORAGE_S3_ACCESS_KEY=<IAM access key>
STORAGE_S3_SECRET_KEY=<IAM secret key>

# Baked into the frontend bundle to build the Content-Security-Policy for audio playback. Leave it
# as the bucket's regional URL unless a CDN sits in front.
STORAGE_PUBLIC_URL_PREFIX=https://<bucket name>.s3.ap-southeast-1.amazonaws.com


# ==============================================================================
# Google Sign-In
# ==============================================================================
# The same client id is read by the backend to verify tokens and baked into the frontend bundle.
# Add https://producerworkbench.online to the client's Authorized JavaScript origins, or the
# button fails in production while working locally.
GOOGLE_CLIENT_ID=<...>.apps.googleusercontent.com


# ==============================================================================
# Cloudflare Turnstile
# ==============================================================================
# Frontend only. The backend contains no Turnstile verification at all, so this renders a widget
# that nothing checks — it stops nobody from calling the API directly. Present because the frontend
# build expects it; treat it as cosmetic until server-side verification exists.
APP_SECURITY_CAPTCHA_TURNSTILE_SITE_KEY=<site key for producerworkbench.online>


# ==============================================================================
# Optional tuning — remove to accept the defaults shown
# ==============================================================================
# NEXT_PUBLIC_AUTH_OTP_EXPIRY_SECONDS=600
# NEXT_PUBLIC_AUTH_OTP_RESEND_COOLDOWN_SECONDS=60
# SPRING_KAFKA_CONSUMER_GROUP_ID=pwb-backend
# PWB_AUDIO_MAX_FILE_SIZE_BYTES=209715200
# PWB_AUDIO_TIMEOUT_MINUTES=15
# STORAGE_S3_ENDPOINT=            # only for an S3-compatible gateway; blank means real AWS
# STORAGE_S3_PATH_STYLE=false


# ==============================================================================
# Deliberately absent
# ==============================================================================
# These appear in the development .env but are read by nothing in the codebase. They were checked
# individually; copying them across would suggest the features behind them are configured.
#
#   APP_JWT_REFRESH_SECRET, AUDIO_AES_MASTER_KEY, AUDIO_IP_HASH_SALT, AUDIO_STREAM_COOKIE_SECRET,
#   PWB_AUDIO_COOKIE_SECRET, PWB_AUDIO_PLAYLIST_SIGNING_KEY, IAM_OUTBOX_ENCRYPTION_KEY
#       — leftovers from the HLS/AES streaming and share-link features, neither of which exists.
#
#   APP_SECURITY_CAPTCHA_TURNSTILE_SECRET_KEY
#       — nothing verifies the captcha server-side, so there is no secret half to configure.
#
#   FFMPEG_PATH, FFPROBE_PATH, FFMPEG_TEMP_DIR, FFMPEG_HOST_TEMP_DIR, VOICE_TEMP_DIR
#       — the application reads PWB_AUDIO_FFMPEG_DIR and PWB_AUDIO_PROCESSOR_WORKING_DIR instead,
#         and the image already ships ffmpeg on PATH with a working directory set.
#
#   STORAGE_PROVIDER, STORAGE_LOCAL_BASE_PATH
#       — only an S3 adapter exists; there is nothing to select between.
#
#   SPRING_DATA_MONGODB_URI  — MongoDB was removed; live room chat is in PostgreSQL.
#   APP_CORS_ALLOWED_ORIGINS — wrong prefix, never read. The real name is PWB_CORS_ALLOWED_ORIGINS,
#                              which compose derives from FRONTEND_DOMAIN.
#   APP_GOOGLE_CLIENT_ID     — duplicate of GOOGLE_CLIENT_ID, which is the one that is read.
#   APP_SEED_*, GCP_PROJECT_ID, COOKIE_SECURE — read by nothing.
